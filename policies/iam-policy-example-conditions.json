{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": ["ec2:TerminateInstances"],
            "Resource": ["*"]
        },
        {"Effect": "Deny",
            "Action": ["ec2:TerminateInstances"],
            "Condition": {
                "NotIpAddress": {
                    "aws:SourceIp": [
                     "192.168.1.1/32"
                     "203.0.113.0/24"
                    ]
                    
                }
            },
            "Resource": ["*"]
        }
    ]
}
